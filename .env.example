# ── Requis ────────────────────────────────────────────────────────────────────
# PostgreSQL. Créer les tables une fois : python -m src.database.init_db
DATABASE_URL=postgresql://username:password@localhost:5432/scholarmap

# SerpAPI (Google Scholar / Google Patents) — https://serpapi.com/
# Une analyse consomme plusieurs dizaines de requêtes.
SERPAPI_KEY=your_serpapi_key_here

# Signature des cookies de session (obligatoire quand FLASK_ENV=production)
FLASK_SECRET_KEY=change-me
FLASK_ENV=development

# ── Optionnel ─────────────────────────────────────────────────────────────────
# OpenAI : reclassement des entités et suggestions de chercheurs proches
# pendant le chargement. Sans clé, ces fonctions sont simplement désactivées.
OPENAI_API_KEY=

# Enrichissement des co-auteurs (h-index, profils). ~2 appels API par co-auteur.
ENRICH_PERSONS=true

# Analyses lancées par adresse IP (syntaxe flask-limiter). Il n'y a pas de compte :
# c'est la principale protection de vos quotas si l'instance est exposée.
# Seules les analyses effectivement lancées sont décomptées.
ANALYSIS_RATE_LIMIT=5 per day
# Stockage partagé du rate limit (sinon en mémoire, par process)
REDIS_URL=
# Recherches de profils (appels OpenAlex) et suggestions OpenAI, par IP
RESOLVE_RATE_LIMIT=60 per minute
SIMILAR_RATE_LIMIT=30 per hour

# Nombre de proxys devant Flask dont on accepte X-Forwarded-For pour l'IP client.
# 1 = le proxy Next.js seul ; 2 = nginx + Next.js. Le port Flask ne doit jamais
# être exposé directement, sinon l'en-tête est falsifiable et le rate limit contournable.
TRUSTED_PROXY_HOPS=1

# Suivi d'erreurs PostHog (laisser vide pour désactiver)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
