# Copiez ce fichier en .env (cp .env.example .env) puis remplissez les clés.
# .env est ignoré par git : vos clés ne seront jamais publiées.

# ── Terminal (python scholarmap.py) ───────────────────────────────────────────

# OpenAlex — clé gratuite fortement recommandée : https://openalex.org/settings/api
# Sans clé, le budget quotidien (0,10 $) est partagé par toute votre adresse IP :
# une ou deux analyses sur un réseau de bureau. Avec clé : 1 $/jour, ~15-20 analyses.
OPENALEX_API_KEY=

# SerpAPI (Google Patents) — optionnel, plan gratuit : 250 requêtes/mois, 50/heure.
# Clé : https://serpapi.com/manage-api-key (après inscription sur serpapi.com)
# Une analyse complète consomme ~11 à 20 requêtes, ~1 à 2 avec --quick.
# Laissé vide, l'analyse fonctionne, sans les brevets.
SERPAPI_KEY=

# OpenAI — optionnel, payant : reclassement IA des entreprises et institutions.
OPENAI_API_KEY=

# E-mail transmis à OpenAlex pour identifier vos requêtes (optionnel)
OPENALEX_EMAIL=

# Les données vont dans un fichier SQLite local (scholarmap.db).
# Pour utiliser PostgreSQL à la place, décommentez et adaptez :
# DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/scholarmap

# ── Appli web uniquement (webapp/ + frontend/) ────────────────────────────────
# Inutile pour le terminal. Voir « Running the web app » dans le README.

# DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/scholarmap
# FLASK_SECRET_KEY=une-longue-chaine-aleatoire
# FLASK_ENV=production

# Analyses lancées par adresse IP (syntaxe flask-limiter). Il n'y a pas de compte :
# c'est la principale protection de vos quotas si l'instance est exposée.
# Seules les analyses effectivement lancées sont décomptées.
# ANALYSIS_RATE_LIMIT=5 per day
# Stockage partagé du rate limit (sinon en mémoire, par process)
# REDIS_URL=redis://localhost:6379/0
# Recherches de profils (appels OpenAlex) et suggestions OpenAI, par IP
# RESOLVE_RATE_LIMIT=60 per minute
# SIMILAR_RATE_LIMIT=30 per hour

# Nombre de proxys devant Flask dont on accepte X-Forwarded-For pour l'IP client.
# 1 = le proxy Next.js seul ; 2 = nginx + Next.js. Le port Flask ne doit jamais
# être exposé directement, sinon l'en-tête est falsifiable et le rate limit contournable.
# TRUSTED_PROXY_HOPS=1

# Suivi d'erreurs PostHog (vide = désactivé)
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
